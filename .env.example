# Server-side only. Copy to .env, which is ignored by Git.
# Default: the exact local Qwen dialogue model used by the original demo.
AVATAR_LLM_PROVIDER=mlx
# Optional local MLX model directory. Empty uses models/qwen.
AVATAR_LLM_MODEL=

# Alternative: a service implementing POST /v1/chat/completions.
# Install/pull/serve the chosen model separately, then configure its actual ID.
# AVATAR_LLM_PROVIDER=openai_compatible
# AVATAR_LLM_BASE_URL=http://127.0.0.1:11434/v1
# AVATAR_LLM_MODEL=your-installed-model-id
# AVATAR_LLM_API_KEY=
# AVATAR_LLM_TIMEOUT=60
# Remote provider use sends dialogue text to the configured service and may incur fees.
